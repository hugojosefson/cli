{
  "name": "@hugojosefson/cli",
  "version": "0.14.2",
  "license": "MIT",
  "hj": {
    "commandName": "hj"
  },
  "minimumDependencyAge": {
    "age": 1440,
    "exclude": [
      "jsr:@hugojosefson/cli"
    ]
  },
  "exports": {
    ".": "./src/cli/cli.ts",
    "./cli": "./src/cli/cli.ts"
  },
  "publish": {
    "include": [
      "src",
      "toolchain.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "docs",
      "readme/generated"
    ],
    "exclude": [
      "src/**/*_test.ts",
      "src/**/*test-fixtures.ts"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6",
    "conventional-changelog-writer": "npm:conventional-changelog-writer@9.2.1",
    "conventional-commits-parser": "npm:conventional-commits-parser@7.1.2",
    "fork-version": "npm:fork-version@5.2.0",
    "jsonc-parser": "npm:jsonc-parser@3.3.1",
    "yaml": "npm:yaml@2.8.3",
    "@inquirer/core": "npm:@inquirer/core@12.0.3",
    "ws": "npm:ws@8.21.3"
  },
  "fmt": {
    "include": [
      "src",
      "scripts",
      "docs",
      ".github",
      "CHANGELOG.md",
      "deno.json",
      "toolchain.json",
      "readme"
    ],
    "exclude": [
      "readme/generated"
    ]
  },
  "tasks": {
    "default": {
      "description": "Fix formatting, then run checks.",
      "command": "deno task --if-present package-metadata && deno task fmt && deno task readme && deno task check"
    },
    "fmt": {
      "description": "Format project source",
      "command": "deno fmt"
    },
    "format": {
      "description": "Check project formatting",
      "command": "deno fmt --check"
    },
    "lint": {
      "description": "Lint source files",
      "command": "deno lint src scripts"
    },
    "typecheck": {
      "description": "Type-check source files",
      "command": "deno check --frozen src/**/*.ts scripts/*.ts"
    },
    "test": {
      "description": "Run tests",
      "command": "deno run --allow-env --allow-run --allow-read --allow-write=/tmp/opencode,.hj/test-results scripts/run-tests.ts"
    },
    "diff-check": {
      "description": "Check the working diff for whitespace errors",
      "command": "git diff --check"
    },
    "check": {
      "description": "Run all non-mutating checks with coverage",
      "dependencies": [
        "ci"
      ]
    },
    "all": {
      "description": "Run all non-mutating checks",
      "dependencies": [
        "ci"
      ]
    },
    "coverage": {
      "description": "Run tests and enforce coverage baselines",
      "command": "deno task test --coverage && deno task coverage-report"
    },
    "coverage-html": {
      "description": "Build a browsable report from the last coverage run",
      "command": "deno task coverage-report --html"
    },
    "ci": {
      "description": "Run validation and coverage once",
      "dependencies": [
        "ci-deno",
        "native-tests"
      ]
    },
    "hj": {
      "description": "Run the local CLI",
      "command": "deno run --allow-env --allow-run=deno --allow-read scripts/run-cli.ts"
    },
    "coverage-report": {
      "description": "Report collected source coverage and enforce baselines",
      "command": "deno run --allow-env --allow-run=deno --allow-read scripts/report-coverage.ts"
    },
    "publish-check": {
      "description": "Validate the package without uploading",
      "command": "deno run --allow-env --allow-run=deno --allow-read scripts/check-package.ts"
    },
    "install-local": {
      "description": "Install hj from this checkout",
      "command": "deno run --allow-env --allow-run=deno --allow-read scripts/install-local.ts"
    },
    "npm-build": {
      "description": "Build the frozen native npm archive without publishing",
      "command": "deno run --allow-env --allow-read --allow-run=deno scripts/build-npm.ts"
    },
    "readme": {
      "description": "Generate README.md.",
      "command": "sh -c 'temp=$(mktemp README.md.XXXXXX) && trap \"rm -f \\\"$temp\\\"\" EXIT && deno run --allow-read=. jsr:@hugojosefson/cli@0.9.0 readme build > \"$temp\" && chmod 444 \"$temp\" && mv \"$temp\" README.md'"
    },
    "readme-example": {
      "description": "Generate the README example from local feature detection",
      "command": "deno run --frozen --allow-sys=uid,gid --allow-run=sh --allow-read=. --allow-write=readme/generated scripts/readme-example.ts"
    },
    "readme-check": {
      "description": "Generate and compare the README and feature example without writes",
      "command": "deno run --frozen --allow-sys=uid,gid --allow-run=sh --allow-read=. scripts/readme-example.ts --check"
    },
    "test-build": {
      "description": "Emit every shared test for native Node and Bun execution",
      "command": "deno run --allow-all scripts/build-tests.ts"
    },
    "native-tests": {
      "description": "Gate CI on all native runtimes and identical executed test inventories",
      "dependencies": [
        "coverage"
      ],
      "command": "deno run --allow-all scripts/run-test-matrix.ts --reuse-deno"
    },
    "test-matrix": {
      "description": "Run every test in Deno, Node 24/26 and Bun",
      "command": "deno run --allow-all scripts/run-test-matrix.ts"
    },
    "ci-deno": {
      "description": "Run Deno coverage and all non-native checks for the parallel CI job",
      "dependencies": [
        "format",
        "lint",
        "typecheck",
        "coverage",
        "diff-check",
        "publish-check",
        "readme-check"
      ]
    },
    "validation-compare": {
      "description": "Compare two fresh validation observation reports without reusing test results",
      "command": "deno run --allow-read scripts/compare-validation.ts"
    }
  },
  "coverage": {
    "thresholds": {
      "lines": 88,
      "branches": 87,
      "functions": 93
    }
  }
}
