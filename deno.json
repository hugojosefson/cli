{
  "name": "@hugojosefson/cli",
  "version": "0.2.0",
  "license": "MIT",
  "minimumDependencyAge": {
    "age": 1440,
    "exclude": ["jsr:@hugojosefson/cli"]
  },
  "exports": {
    ".": "./src/cli/cli.ts",
    "./cli": "./src/cli/cli.ts"
  },
  "publish": {
    "include": [
      "src",
      "toolchain.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "docs"
    ],
    "exclude": [
      "src/**/*_test.ts",
      "src/**/*test-fixtures.ts"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli/unstable-prompt-multiple-select": "jsr:@std/cli@1.0.32/unstable-prompt-multiple-select",
    "@std/path": "jsr:@std/path@^1.1.3",
    "fork-version": "npm:fork-version@5.2.0",
    "jsonc-parser": "npm:jsonc-parser@3.3.1",
    "yaml": "npm:yaml@2.8.3"
  },
  "fmt": {
    "include": [
      "src",
      "scripts",
      "docs",
      ".github",
      "README.md",
      "CHANGELOG.md",
      "deno.json",
      "toolchain.json"
    ]
  },
  "tasks": {
    "fmt": {
      "description": "Format project source",
      "command": "deno fmt"
    },
    "format": {
      "description": "Check project formatting",
      "command": "deno fmt --check"
    },
    "lint": {
      "description": "Lint source files",
      "command": "deno lint src scripts"
    },
    "typecheck": {
      "description": "Type-check source files",
      "command": "deno check --frozen src/**/*.ts scripts/*.ts"
    },
    "test": {
      "description": "Run tests",
      "command": "deno run --allow-env --allow-run=deno --allow-read --allow-write=/tmp/opencode scripts/run-tests.ts"
    },
    "diff-check": {
      "description": "Check the working diff for whitespace errors",
      "command": "git diff --check"
    },
    "check": {
      "description": "Run all non-mutating checks",
      "dependencies": [
        "format",
        "lint",
        "typecheck",
        "test",
        "diff-check",
        "publish-check"
      ]
    },
    "all": {
      "description": "Run all non-mutating checks",
      "dependencies": [
        "ci"
      ]
    },
    "coverage": {
      "description": "Run tests and enforce coverage baselines",
      "command": "deno task test --coverage && deno task coverage-report"
    },
    "coverage-html": {
      "description": "Build a browsable report from the last coverage run",
      "command": "deno task coverage-report --html"
    },
    "ci": {
      "description": "Run validation and coverage once",
      "dependencies": [
        "format",
        "lint",
        "typecheck",
        "coverage",
        "diff-check",
        "publish-check"
      ]
    },
    "hj": {
      "description": "Run the local CLI",
      "command": "deno run --allow-env --allow-run=deno --allow-read scripts/run-cli.ts"
    },
    "coverage-report": {
      "description": "Report collected source coverage and enforce baselines",
      "command": "deno run --allow-env --allow-run=deno --allow-read scripts/report-coverage.ts"
    },
    "publish-check": {
      "description": "Validate the package without uploading",
      "command": "deno run --allow-env --allow-run=deno --allow-read scripts/check-package.ts"
    },
    "install-local": {
      "description": "Install hj from this checkout",
      "command": "deno run --allow-env --allow-run=deno --allow-read scripts/install-local.ts"
    }
  },
  "coverage": {
    "thresholds": {
      "lines": 88,
      "branches": 87,
      "functions": 93
    }
  }
}
